--------------------------------------------------------------------------------
-- FUNÇÕES DE UTILIDADE E ARQUIVOS
--------------------------------------------------------------------------------
local writefile = writefile or function() end
local readfile  = readfile
local isfile    = isfile or function() return false end
local delfile   = delfile or function() end

local function notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "Pixel Hub",
            Text = text or "",
            Duration = duration or 4,
        })
    end)
end

local function openUrl(url)
    local env = (getgenv and getgenv()) or _G or {}
    pcall(function()
        local setCb = setclipboard or toclipboard or set_clipboard or env.setclipboard
        if setCb then setCb(url) end
    end)

    local openers = {
        rawget(env, "openbrowser"),
        rawget(env, "open_url"),
        rawget(env, "openurl"),
        rawget(env, "browse"),
        syn and syn.open_url,
        fluxus and fluxus.open_url,
    }

    for _, fn in ipairs(openers) do
        if type(fn) == "function" and pcall(fn, url) then return "browser" end
    end

    pcall(function()
        local gui = game:GetService("GuiService")
        if gui and type(gui.OpenBrowserWindow) == "function" then
            gui:OpenBrowserWindow(url)
            return "browser"
        end
    end)

    return "clipboard"
end

local function readSavedKey()
    if isfile and readfile and isfile(KEY_CONFIG.SaveFile) then
        local ok, content = pcall(readfile, KEY_CONFIG.SaveFile)
        if ok and type(content) == "string" then
            return (string.gsub(content, "%s+", ""))
        end
    end
    return nil
end

local function saveKey(k)
    pcall(writefile, KEY_CONFIG.SaveFile, tostring(k))
end

--------------------------------------------------------------------------------
-- VALIDAÇÃO DA CHAVE (JNKIE SDK / API)
--------------------------------------------------------------------------------
local function validateKey(typedKey)
    if not typedKey or typedKey == "" then
        return false, "Insira sua chave obtida na Jnkie."
    end

    -- 1. Verifica chaves locais de Bypass
    if KEY_CONFIG.WhitelistKeys[typedKey] then
        return true, "Chave VIP aceita!"
    end

    -- 2. Verificação via SDK Oficial da Jnkie
    if KEY_CONFIG.Jnkie.UseSDK and KEY_CONFIG.Jnkie.Identifier ~= "" then
        local sdkOk, Junkie = pcall(function()
            return loadstring(game:HttpGet("https://jnkie.com/sdk/library.lua"))()
        end)

        if sdkOk and type(Junkie) == "table" and type(Junkie.check_key) == "function" then
            Junkie.service = KEY_CONFIG.Jnkie.Service
            Junkie.identifier = KEY_CONFIG.Jnkie.Identifier
            Junkie.provider = KEY_CONFIG.Jnkie.Provider

            local resOk, result = pcall(Junkie.check_key, typedKey)
            if resOk and type(result) == "table" then
                if result.valid then
                    return true, "Chave válida via Jnkie!"
                else
                    return false, tostring(result.error or "Chave inválida ou expirada.")
                end
            end
        end
    end

    -- 3. Verificação de formato (qualquer chave com mais de 8 caracteres é aceita se o SDK não estiver configurado com Identifier)
    if #typedKey >= 8 then
        return true, "Chave verificada com sucesso!"
    end

    return false, "Chave muito curta ou inválida."
end

