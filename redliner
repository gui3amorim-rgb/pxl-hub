--------------------------------------------------------------------------------
-- CARREGAMENTO DO PIXEL HUB
--------------------------------------------------------------------------------
local function startHub()
    notify("Pixel Hub", "Carregando scripts...", 4)

    local HUB_URL = "https://raw.githubusercontent.com/seltonmt012/sel01-rbx/main/loader.lua"
    local ok, source = pcall(function() return game:HttpGet(HUB_URL, false) end)
    if not ok or not source or #source < 50 then
        notify("Pixel Hub", "Falha ao baixar o loader.", 6)
        return
    end

    -- Patcher de estilo para manter tema azul e títulos Pixel Hub
    source = source:gsub('UI%.BRAND%s*=%s*"SELUX"', 'UI.BRAND = "PIXEL HUB"')
    source = source:gsub('UI%.DISCORD%s*=%s*"[^"]+"', 'UI.DISCORD = "discord.gg/uNU9YUsxdR"')
    source = source:gsub('UI%.LOGO%s*=%s*"selux%-mark%.png"', 'UI.LOGO = "' .. KEY_CONFIG.Icon .. '"')
    source = source:gsub('options%.badge or "S"', 'options.badge or ""')

    local fn, err = loadstring(source, "@pixelhub_core")
    if not fn then
        notify("Pixel Hub", "Erro no script: " .. tostring(err), 8)
        return
    end

    pcall(fn)
end

